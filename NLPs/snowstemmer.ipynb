   "source": [
    "from nltk.stem import SnowballStemmer\n",
    "\n",
    "SnowballStemmer=SnowballStemmer('english')\n",
    "\n",
    "words=[\"eating\",\"eat\",\"eaten\",\"had\",\"having\"]\n",
    "for word in words:\n",
    "    print(word+\"--->\"+SnowballStemmer.stem(word))"
   ]
